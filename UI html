function renderCustTable(){
  const tb=document.getElementById('custBody');tb.innerHTML='';
  custPts.forEach((p,i)=>{
    const tr=document.createElement('tr');
    tr.innerHTML=`
      <td style="color:var(--muted);font-family:var(--mono);font-size:9px;padding:3px 8px">${i+1}</td>
      <td style="padding:3px 8px"><input type="number" value="${p.x.toFixed(2)}" min="0" max="${MAX_LEN}" step="1"
        onchange="
          var v=clamp(this.value,0,${MAX_LEN});
          if(v>${MAX_LEN}){this.classList.add('invalid');return;}
          this.classList.remove('invalid');
          custPts[${i}].x=v;buildProfile()
        "></td>
      <td style="padding:3px 8px"><input type="number" value="${p.d.toFixed(2)}" min="20" max="160" step="1" onchange="custPts[${i}].d=clamp(this.value,20,160);buildProfile()"></td>
      <td style="padding:3px 8px"><button class="rm" onclick="custPts.splice(${i},1);renderCustTable();buildProfile()">×</button></td>`;
    tb.appendChild(tr);
  });
}
function addCustPt(){
  const lx=custPts.length?custPts[custPts.length-1].x+10:0;
  // Cap new point at 750
  custPts.push({x:Math.min(lx, MAX_LEN), d:50});
  renderCustTable();buildProfile();
}

