// ══════════════════════════════════════════
window.addEventListener('load',()=>{
  setAxes(4);
  setProfileMode('cylhemi');
  buildProfile();
  renderLayers();
  requestAnimationFrame(()=>requestAnimationFrame(redraw));
  if('serial' in navigator) scanPorts();
  else logMsg('Web Serial requires Chrome or Edge','err');
});
window.addEventListener('resize',redraw);
