function clamp(v,mn,mx){return Math.min(mx,Math.max(mn,+v||mn));}

function validateInput(el,mn,mx){
  const v=parseFloat(el.value);
  if(isNaN(v)||v<mn||v>mx){
    el.classList.add('invalid');
  } else {
    el.classList.remove('invalid');
    el.value=v;
  }
}

function propagateDiameter(){renderBuildUI();buildProfile();}

function addLayer(){
  if (layers.length >= 10) {
    logMsg('Maximum limit of 10 layers reached', 'err');
    alert("You cannot add more than 10 layers for this job.");
    return; // Exit the function so no layer is added
  }
  layers.push({
    length:   clamp(gv('ll'),1,750),
    angle:    clamp(gv('la'),0,90),
    offset:   clamp(gv('lo'),0,740),
    stepover: clamp(gv('ls'),0,25),
    dwell:    clamp(gv('ld'),0,360),
  });
  renderLayers();redraw();
}

function rmLayer(i){layers.splice(i,1);renderLayers();redraw();}
function renderLayers(){
  const el=document.getElementById('layerList');
  if(!layers.length){el.innerHTML='<div class="empty-note">No layers yet — fill fields above and click Add</div>';return;}
  el.innerHTML=layers.map((l,i)=>`
    <div class="layer-card">
      <span class="lnum">L${i+1}</span>
      <div class="lstats">
        <div class="lstat"><span class="lsl">Angle</span><span class="lsv">${l.angle}°</span></div>
        <div class="lstat"><span class="lsl">Length</span><span class="lsv">${l.length}mm</span></div>
        <div class="lstat"><span class="lsl">Offset</span><span class="lsv">${l.offset}mm</span></div>
        <div class="lstat"><span class="lsl">Step</span><span class="lsv">${l.stepover}mm</span></div>
        <div class="lstat"><span class="lsl">Dwell</span><span class="lsv">${l.dwell}°</span></div>
      </div>
      <button class="rm" onclick="rmLayer(${i})">×</button>
    </div>`).join('');
}

