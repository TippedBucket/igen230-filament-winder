function buildJSON(){
  let d = 50;
  if (numAxes < 4) {
    d = +gv('manDiam') || 50;
  } else {
    if (profileMode === 'cylhemi') d = +gv('ch-diam') || 50;
    else if (profilePts.length) d = Math.max(...profilePts.map(p=>p.r*2));
  }
  const so=+gv('standoff')||100;
  const job={
    mandrel_diameter:+d.toFixed(3), axes:numAxes,
    ...(numAxes>=4&&{standoff:so}),
    ...(numAxes<4&&{mandrel_length:+(gv('manLen')||400)}),
    ...(numAxes>=4&&profilePts.length>=2&&{profile:profilePts.map(p=>({x:+p.x.toFixed(3),d:+(p.r*2).toFixed(3)}))}),
    layers:layers.map(l=>({length:l.length,angle:l.angle,offset:l.offset,stepover:l.stepover,dwell:l.dwell}))
  };
  return JSON.stringify(job);
}
function copyJSON(){navigator.clipboard.writeText(buildJSON()).then(()=>logMsg('JSON copied','sys'));}
function refreshSummary(){
  document.getElementById('sumAxes').textContent=numAxes;
  let d = 50;
  if (numAxes < 4) d = +gv('manDiam') || 50;
  else if (profileMode === 'cylhemi') d = +gv('ch-diam') || 50;
  else if (profilePts.length) d = Math.max(...profilePts.map(p=>p.r*2));
  document.getElementById('sumDiam').innerHTML=d.toFixed(1)+'<span class="su">mm</span>';
  document.getElementById('sumLayers').textContent=layers.length;
  document.getElementById('jsonOut').textContent=buildJSON();
  const names=['Mandrel','Carriage','Toolhead','Toolarm'];
  document.getElementById('axBadges').innerHTML=names.map((n,i)=>
    `<span class="ax-badge ${i<numAxes?'on':'off'}">${i<numAxes?'●':'○'} ${n}</span>`).join('');
}

// ══════════════════════════════════════════
// Canvas
// ══════════════════════════════════════════
function redraw(){
  const canvas=document.getElementById('mainCanvas');
  const wrap=canvas.parentElement;
  const dpr=window.devicePixelRatio||1;
  const W=wrap.clientWidth|0, H=wrap.clientHeight|0;
  if(!W||!H)return;
  canvas.width=W*dpr; canvas.height=H*dpr;
  canvas.style.width=W+'px'; canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,W,H);

  const pts  = numAxes>=4 ? profilePts : null;
  let D = 50;
  if (numAxes < 4) D = +gv('manDiam') || 50;
  else if (profileMode === 'cylhemi') D = +gv('ch-diam') || 50;
  else if (profilePts && profilePts.length) D = Math.max(...profilePts.map(p=>p.r*2));
  const R    = D/2;
  const so   = numAxes>=4 ? (+gv('standoff')||100) : 0;

  const maxX = (pts&&pts.length>=2) ? Math.max(...pts.map(p=>p.x)) : (+gv('manLen')||400);
  const maxR = pts&&pts.length>=2 ? Math.max(...pts.map(p=>p.r)) : R;
  const pad  = {l:60,r:40,t:20,b:20};
  const drawW = W - pad.l - pad.r;
  const drawH = H - pad.t - pad.b;
  const sx = drawW / (maxX||1);
  const margin = maxR * 0.12 + 3;
  const totalR = maxR + margin;
  const sy = (drawH/2) / totalR;
  const sc = Math.min(sx, sy);
  const ox = pad.l;
  const usedH = totalR * sc;
  const oy = pad.t + usedH + Math.max(0, (drawH - usedH*2) / 2);

  const tx = x => ox + x*sc;
  const ty = r => oy - r*sc;

  ctx.strokeStyle='#0d1520';ctx.lineWidth=1;
  const gridStep = nicestep(totalR*1.1);
  for(let r=gridStep;r<=totalR*1.05;r+=gridStep){
    ctx.beginPath();ctx.moveTo(ox,ty(r));ctx.lineTo(ox+maxX*sc,ty(r));ctx.stroke();
    ctx.beginPath();ctx.moveTo(ox,ty(-r));ctx.lineTo(ox+maxX*sc,ty(-r));ctx.stroke();
  }
  const xGridStep = nicestep(maxX*0.9);
  for(let xg=xGridStep;xg<=maxX;xg+=xGridStep){
    ctx.beginPath();ctx.moveTo(tx(xg),ty(totalR));ctx.lineTo(tx(xg),ty(-totalR));ctx.stroke();
  }

  ctx.strokeStyle='#1e2a38';ctx.lineWidth=1;ctx.setLineDash([5,4]);
  ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(ox+maxX*sc,oy);ctx.stroke();
  ctx.setLineDash([]);

  if(so>0 && pts && pts.length>=2){
    ctx.strokeStyle='rgba(62,207,255,.18)';ctx.lineWidth=1;ctx.setLineDash([4,4]);
    ctx.beginPath();pts.forEach((p,i)=>i===0?ctx.moveTo(tx(p.x),ty(-p.r-so)):ctx.lineTo(tx(p.x),ty(-p.r-so)));ctx.stroke();
    ctx.setLineDash([]);
  }

  if(pts && pts.length>=2){
    ctx.strokeStyle='#3ecfff';ctx.lineWidth=2;
    ctx.beginPath();pts.forEach((p,i)=>i===0?ctx.moveTo(tx(p.x),ty(p.r)):ctx.lineTo(tx(p.x),ty(p.r)));ctx.stroke();
    ctx.beginPath();pts.forEach((p,i)=>i===0?ctx.moveTo(tx(p.x),ty(-p.r)):ctx.lineTo(tx(p.x),ty(-p.r)));ctx.stroke();
    ctx.strokeStyle='rgba(62,207,255,.4)';ctx.lineWidth=1;
    const p0=pts[0], pN=pts[pts.length-1];
    ctx.beginPath();ctx.moveTo(tx(p0.x),ty(p0.r));ctx.lineTo(tx(p0.x),ty(-p0.r));ctx.stroke();
    ctx.beginPath();ctx.moveTo(tx(pN.x),ty(pN.r));ctx.lineTo(tx(pN.x),ty(-pN.r));ctx.stroke();
    ctx.beginPath();
    pts.forEach((p,i)=>i===0?ctx.moveTo(tx(p.x),ty(p.r)):ctx.lineTo(tx(p.x),ty(p.r)));
    [...pts].reverse().forEach(p=>ctx.lineTo(tx(p.x),ty(-p.r)));
    ctx.closePath();ctx.fillStyle='rgba(62,207,255,.04)';ctx.fill();
  } else {
    ctx.strokeStyle='#3ecfff';ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(ox,ty(R));ctx.lineTo(ox+maxX*sc,ty(R));ctx.stroke();
    ctx.beginPath();ctx.moveTo(ox,ty(-R));ctx.lineTo(ox+maxX*sc,ty(-R));ctx.stroke();
    ctx.strokeStyle='rgba(62,207,255,.35)';ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(ox,ty(R));ctx.lineTo(ox,ty(-R));ctx.stroke();
    ctx.beginPath();ctx.moveTo(ox+maxX*sc,ty(R));ctx.lineTo(ox+maxX*sc,ty(-R));ctx.stroke();
    ctx.fillStyle='rgba(62,207,255,.04)';
    ctx.fillRect(ox,ty(R),maxX*sc,ty(-R)-ty(R));
  }

  if(pts && pts.length>=2){
    ctx.fillStyle='#3ecfff';
    pts.forEach(p=>{
      ctx.beginPath();ctx.arc(tx(p.x),ty(p.r),2,0,Math.PI*2);ctx.fill();
      ctx.beginPath();ctx.arc(tx(p.x),ty(-p.r),2,0,Math.PI*2);ctx.fill();
    });
  }

  if(layers.length){
    const COLS=['#3ecfff','#ff7a45','#2ed891','#ffd045','#c07ef0','#ff4a5e'];
    layers.forEach((layer,li)=>{
      const col=COLS[li%COLS.length];
      const L=layer.length, off=layer.offset;
      const passes=Math.min(14,Math.max(4,Math.ceil((Math.PI*maxR*2)/layer.stepover/3)));
      const angRad=(layer.angle*Math.PI)/180;

      for(let p=0;p<passes;p++){
        const fwd=p%2===0;
        const alpha=0.25+0.55*(p/(passes-1||1));
        ctx.strokeStyle=col+Math.floor(alpha*255).toString(16).padStart(2,'0');
        ctx.lineWidth=1.2;

        ctx.beginPath();
        const steps=80;
        for(let s=0;s<=steps;s++){
          const frac=s/steps;
          const xMand=fwd?(off+frac*L):(off+(1-frac)*L);
          const cx=Math.max(0,Math.min(maxX,xMand));

          let r=maxR;
          if(pts&&pts.length>=2){
            for(let pi=0;pi<pts.length-1;pi++){
              if(cx>=pts[pi].x&&cx<=pts[pi+1].x){
                const a=(cx-pts[pi].x)/(pts[pi+1].x-pts[pi].x);
                r=pts[pi].r+a*(pts[pi+1].r-pts[pi].r);break;
              }
            }
          }

          const helixPeriod = (Math.PI*2*r)/Math.tan(angRad+0.001);
          const phaseShift  = (off*Math.PI*2/helixPeriod)*p;
          const theta = (cx/helixPeriod)*Math.PI*2*(fwd?1:-1) + phaseShift + p*0.9;
          const cosT  = Math.cos(theta);
          const yOff = r * cosT;

          const canvasX=tx(cx);
          const canvasY=oy - yOff*sc;
          s===0?ctx.moveTo(canvasX,canvasY):ctx.lineTo(canvasX,canvasY);
        }
        ctx.stroke();
      }
    });
  }

  ctx.fillStyle='#5c7088';ctx.font='9px DM Mono';ctx.textAlign='center';
  ctx.fillText('0',ox-14,oy+18);
  ctx.fillText(maxX.toFixed(0)+'mm',tx(maxX)+28,oy+18);
  ctx.textAlign='left';
  ctx.fillText('⌀'+(maxR*2).toFixed(1)+'mm',ox-28,ty(maxR));

  if(layers.length){
    const COLS=['#3ecfff','#ff7a45','#2ed891','#ffd045','#c07ef0','#ff4a5e'];
    ctx.font='9px DM Mono';ctx.textAlign='left';
    layers.slice(0,6).forEach((l,i)=>{
      const LCOL=COLS[i%COLS.length];
      ctx.fillStyle=LCOL;ctx.fillRect(W-140,pad.t+4+i*14,11,2);
      ctx.fillStyle='#7a8fa8';ctx.fillText('L'+(i+1)+'  '+l.angle+'°  '+l.length+'mm',W-123,pad.t+8+i*14);
    });
  }

  ctx.fillStyle='#3a4f66';ctx.font='14px DM Mono';ctx.textAlign='left';
  ctx.fillText('WINDING PREVIEW',pad.l,oy - usedH - 6);
}

function nicestep(range){
  if(!range||range<=0)return 10;
  const raw=range/4;
  const mag=Math.pow(10,Math.floor(Math.log10(raw)));
  const norm=raw/mag;
  let step=norm<1.5?1:norm<3.5?2:norm<7.5?5:10;
  return step*mag;
}

// ══════════════════════════════════════════
// Serial
// ══════════════════════════════════════════

async function scanPorts(){
  if(!('serial' in navigator)){logMsg('Web Serial not available','err');return;}
  const ports=await navigator.serial.getPorts();
  const sel=document.getElementById('portSel');
  sel.innerHTML='<option value="">— select port —</option>';
  ports.forEach((p,i)=>{const o=document.createElement('option');o.value=i;o.textContent='Port '+i;sel.appendChild(o);});
  logMsg(ports.length?'Found '+ports.length+' port(s)':'No saved ports — click Connect to request access','sys');
}

async function toggleConnect(){connected?doDisconnect():doConnect();}

async function doConnect(){
  if(!('serial' in navigator)){logMsg('Requires Chrome or Edge','err');return;}
  try{
    port=await navigator.serial.requestPort();
    await port.open({baudRate:115200});
    connected=true;
    setStatus('ok','CONNECTED');
    document.getElementById('connectBtn').textContent='Disconnect';
    document.getElementById('sendBtn').disabled=false;
    logMsg('Port opened — 115200 baud','rx');
    readLoop();
  }catch(e){logMsg('Connection failed: '+e.message,'err');}
}

async function doDisconnect(){
  connected=false;
  try{
    if(serialReader){ await serialReader.cancel(); serialReader=null; }
    if(port){ await port.close(); port=null; }
  }catch(e){}
  setStatus('','NOT CONNECTED');
  document.getElementById('connectBtn').textContent='Connect';
  document.getElementById('sendBtn').disabled=true;
  logMsg('Disconnected','err');
}

async function readLoop(){
  const decoder = new TextDecoderStream();
  const streamClosed = port.readable.pipeTo(decoder.writable);
  serialReader = decoder.readable.getReader();
  let buf='';
  try{
    while(connected){
      const{value,done}=await serialReader.read();
      if(done) break;
      buf+=value;
      const lines=buf.split('\n'); buf=lines.pop();
      lines.forEach(l=>{
        const s=l.trim(); if(!s)return;
        logMsg(s,'rx');
        if(s==='READY') setStatus('ok','READY');
        if(s.startsWith('STATE:')) setStatus('live',s.replace('STATE:','').trim());
        if(s==='STATE: COMPLETE') setStatus('ok','COMPLETE');
      });
    }
  }catch(e){
    if(connected) logMsg('Read error: '+e.message,'err');
  }finally{
    serialReader=null;
  }
}

async function sendJob(){
  if(!connected){logMsg('Not connected','err');return;}
  refreshSummary();
  const json=buildJSON()+'\n';
  logMsg('Sending '+json.length+' bytes...','tx');
  try{
    // Pause the reader so we can write
    await serialReader.cancel();
    serialReader=null;

    // Write
    const writer=port.writable.getWriter();
    await writer.write(new TextEncoder().encode(json));
    writer.releaseLock();
    logMsg('Job transmitted successfully','tx');
    setStatus('live','WINDING...');

    // Small delay then restart reader
    await new Promise(r=>setTimeout(r,100));
    readLoop();
  }catch(e){
    logMsg('Send error: '+e.message,'err');
    readLoop();
  }
}
function logMsg(msg,type=''){
  const log=document.getElementById('serialLog');
  const t=new Date().toTimeString().slice(0,8);
  const d=document.createElement('div');d.className='lr';
  d.innerHTML=`<span class="lt">${t}</span><span class="lm ${type}">${msg}</span>`;
  log.appendChild(d);log.scrollTop=log.scrollHeight;
}
function clearLog(){document.getElementById('serialLog').innerHTML='';}
function setStatus(cls,txt){
  const p=document.getElementById('statusPill');
  p.className='status-pill '+(cls||'');
  document.getElementById('statusTxt').textContent=txt;
}

