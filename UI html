<script>
// ══════════════════════════════════════════
// State
// ══════════════════════════════════════════
const MAX_LEN = 750;
let numAxes=4, profilePts=[], layers=[], profileMode='cylhemi', custPts=[];
let buildSegs={left:{type:'Hemisphere',d:50,len:30},middles:[],right:{type:'Hemisphere',d:50,len:30}};
let port=null, connected=false;
let serialReader = null;

const AXDESC={
  2:'Mandrel and Carriage only. Winding at a fixed fibre angle.',
  3:'Adds Toolhead rotation — Tracks the fibre angle on direction changes.',
  4:'4-axis: Mandrel, Carriage, Toolhead, and Toolarm. Required for non-uniform shapes.'
};
const SEG_TYPES=['Hemisphere','Tangent Ogive','Cone','Straight Cylinder','Flat End Cap'];

// ══════════════════════════════════════════
// Navigation
// ══════════════════════════════════════════
function showPage(n){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.page-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('page-'+n).classList.add('active');
  document.getElementById('pt-'+n).classList.add('active');
  if(n==='transmit') refreshSummary();
  setTimeout(redraw,40);
}
function cfgTab(n){
  document.querySelectorAll('.cfg-tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.cfg-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('ct-'+n).classList.add('active');
  document.getElementById('cp-'+n).classList.add('active');
  setTimeout(redraw,40);
}

// ══════════════════════════════════════════
// Axes
// ══════════════════════════════════════════
function setAxes(n){
  numAxes=n;
  [2,3,4].forEach(x=>document.getElementById('ax'+x).classList.toggle('active',x===n));
  document.getElementById('axDesc').textContent=AXDESC[n];
  const need4=n===4;
  document.getElementById('ct-profile').style.display=need4?'':'none';
  document.getElementById('soFld').style.display=need4?'flex':'none';
  const sp=document.getElementById('simpleParams');
  if(sp) sp.style.display=need4?'none':'flex';
  if(!need4&&document.getElementById('cp-profile').classList.contains('active')) cfgTab('axes');
  buildProfile(); redraw();
}

// ══════════════════════════════════════════
// Profile mode
// ══════════════════════════════════════════
function setProfileMode(m){
  profileMode=m;
  document.querySelectorAll('.pmode').forEach(el=>el.classList.toggle('active',el.id==='pm-'+m));
  document.querySelectorAll('.profile-sub').forEach(el=>el.classList.toggle('active',el.id==='ps-'+m));
  if(m==='build')  renderBuildUI();
  if(m==='custom') renderCustTable();
  buildProfile();
}

// ══════════════════════════════════════════
// Total length — single source of truth
// ══════════════════════════════════════════
function getTotalLength(){
  if(numAxes<4) return +gv('manLen')||400;
  if(profileMode==='cylhemi'){
    const R=(+gv('ch-diam')||50)/2;
    const L=+gv('ch-len')||400;
    return R*2 + L;
  } else if(profileMode==='build'){
    let total=0;
    const ls=buildSegs.left;
    if(ls.type==='Hemisphere') total+=(ls.d||50)/2;
    else total+=(ls.len||30);
    buildSegs.middles.forEach(s=>total+=(s.len||50));
    const rs=buildSegs.right;
    if(rs.type==='Hemisphere') total+=(rs.d||50)/2; // right hemisphere inherits prev radius
    else total+=(rs.len||30);
    return total;
  } else if(profileMode==='custom'){
    if(!custPts.length) return 0;
    return Math.max(...custPts.map(p=>p.x));
  }
  return 0;
}

// How much length budget remains for a segment being edited.
// ownLen: the segment's current COMMITTED length — we subtract it from the
// total so the ceiling = "what's left if this segment contributes 0".
// Uses committed getTotalLength() (not live DOM) because this is called at
// render time to snapshot the ceiling before the user starts typing.
function remainingBudget(ownLen){
  return MAX_LEN - (getTotalLength() - ownLen);
}

// Update the length display bar.
// In build mode we sum live DOM input values so the bar reacts while the user
// is still typing (even before the value is committed to buildSegs state).
function updateLengthBar(){
  let total;
  if(numAxes >= 4 && profileMode === 'build'){
    total = getLiveBuildLength();
  } else {
    total = getTotalLength();
  }
  const valEl  = document.getElementById('lengthVal');
  const warnEl = document.getElementById('lengthWarn');
  if(!valEl) return;
  valEl.textContent = total.toFixed(1) + 'mm';
  valEl.style.color = total > MAX_LEN ? 'var(--red)' : total > MAX_LEN*0.9 ? 'var(--yellow)' : 'var(--accent)';
  if(total > MAX_LEN){
    warnEl.style.display='';
    warnEl.textContent='⚠ Exceeds 750mm limit by '+(total-MAX_LEN).toFixed(1)+'mm';
  } else {
    warnEl.style.display='none';
  }
}

// Sum all numeric inputs inside #buildArea to get a live total including
// partially-typed values that haven't been committed to buildSegs yet.
function getLiveBuildLength(){
  // Fall back to committed state if the build area isn't rendered yet
  const area = document.getElementById('buildArea');
  if(!area) return getTotalLength();

  // We re-compute from buildSegs but substitute any live input values where
  // the input exists and has a valid number.
  let total = 0;

  // Left end
  const ls = buildSegs.left;
  if(ls.type === 'Hemisphere'){
    // Diameter input in left section — find first input in first .build-section
    const leftSec = area.querySelector('.build-section');
    const dInp = leftSec ? leftSec.querySelector('input') : null;
    const d = dInp ? (+dInp.value || ls.d || 50) : (ls.d || 50);
    total += d / 2;
  } else {
    // Has a length input — second input in left section (first is diameter)
    const leftSec = area.querySelector('.build-section');
    const inputs = leftSec ? leftSec.querySelectorAll('input') : [];
    const lenInp = inputs[inputs.length - 1]; // last input is length for non-hemi
    total += lenInp ? (+lenInp.value || ls.len || 30) : (ls.len || 30);
  }

  // Middle sections — each .build-section after the first and before the last
  const allSections = area.querySelectorAll('.build-section');
  // sections: [left, ...middles..., addBtn?, right]
  // The add-button section has no select with segment types, so skip it
  const midSections = Array.from(allSections).slice(1, -1).filter(s => s.querySelector('.bz-type-sel'));
  midSections.forEach((sec, i) => {
    const seg = buildSegs.middles[i];
    if(!seg) return;
    const inputs = sec.querySelectorAll('input[type="number"]');
    // First input is always length for middle sections
    const lenInp = inputs[0];
    total += lenInp ? (+lenInp.value || seg.len || 50) : (seg.len || 50);
  });

  // Right end
  const rs = buildSegs.right;
  if(rs.type === 'Hemisphere'){
    // Right hemisphere inherits prevR — its length = prevR (last middle or left radius)
    // We can't easily read this from DOM, so use committed value
    const joints = getJointDiameters();
    const prevD = joints[joints.length - 1].startD;
    total += prevD / 2;
  } else {
    const rightSec = allSections[allSections.length - 1];
    const inputs = rightSec ? rightSec.querySelectorAll('input[type="number"]') : [];
    const lenInp = inputs[inputs.length - 1];
    total += lenInp ? (+lenInp.value || rs.len || 30) : (rs.len || 30);
  }

  return total;
}

// ══════════════════════════════════════════
// CylHemi change handler — enforces total ≤ 750
// ══════════════════════════════════════════
function onCylHemiChange(){
  const diamInp = document.getElementById('ch-diam');
  const lenInp  = document.getElementById('ch-len');
  const R = Math.min(160, Math.max(20, +diamInp.value||50)) / 2;
  // Max cylinder length given current diameter
  const maxCylLen = MAX_LEN - R*2;
  const rawLen = +lenInp.value||0;

  validateInput(diamInp, 20, 160);

  if(rawLen < 1){
    lenInp.classList.add('invalid');
  } else if(rawLen > maxCylLen){
    lenInp.classList.add('invalid');
    // Show what the max is in a tooltip-style title
    lenInp.title = 'Max cylinder length at this diameter: ' + maxCylLen.toFixed(0) + 'mm';
  } else {
    lenInp.classList.remove('invalid');
    lenInp.title = '';
  }

  buildProfile();
}

// ══════════════════════════════════════════
// Tangent ogive sampler
// ══════════════════════════════════════════
function sampleOgive(xStart, baseR, noseLen, steps=20){
  if(noseLen<=0||baseR<=0) return [{x:xStart,r:baseR}];
  const L=noseLen, R=baseR;
  const rho=(L*L+R*R)/(2*R);
  const pts=[];
  for(let i=0;i<=steps;i++){
    const t=i/steps;
    const x=t*L;
    const val=rho*rho-(L-x)*(L-x);
    const r=Math.sqrt(Math.max(0,val))-(rho-R);
    pts.push({x:xStart+x, r:Math.max(0,r)});
  }
  return pts;
}

// ══════════════════════════════════════════
// Profile computation
// ══════════════════════════════════════════
function buildProfile(){
  if(numAxes<4){profilePts=[];redraw();return;}
  let pts=[];

  if(profileMode==='cylhemi'){
    const L=+gv('ch-len')||400, R=(+gv('ch-diam')||50)/2;
    for(let i=0;i<=12;i++){
      const t=(i/12)*(Math.PI/2);
      pts.push({x:R*(1-Math.cos(t)), r:R*Math.sin(t)});
    }
    pts.push({x:R+L, r:R});
    for(let i=1;i<=12;i++){
      const t=(i/12)*(Math.PI/2);
      pts.push({x:R+L+R*Math.sin(t), r:R*Math.cos(t)});
    }

  } else if(profileMode==='build'){
    pts=buildSegmentProfile();

  } else if(profileMode==='custom'){
    pts=custPts.map(p=>({x:p.x, r:(p.d||50)/2}));
  }

  const seen=new Set();
  profilePts=pts.filter(p=>{const k=p.x.toFixed(4);if(seen.has(k))return false;seen.add(k);return true;});

  updateLengthBar();
  redraw();
}

function gv(id){return document.getElementById(id)?.value;}

// ══════════════════════════════════════════
// Build mode UI — flat inline row
// ══════════════════════════════════════════
function renderBuildUI(){
  const area=document.getElementById('buildArea');
  area.innerHTML='';

  const row=document.createElement('div');
  row.className='build-row';

  row.appendChild(makeBuildSection('left', buildSegs.left));
  row.appendChild(makeBuildSep());

  buildSegs.middles.forEach((seg,i)=>{
    row.appendChild(makeMidSeg(seg,i));
    row.appendChild(makeBuildSep());
  });

  if(buildSegs.middles.length<8){
    const addSec=document.createElement('div');
    addSec.className='build-section';

    const lbl=document.createElement('span');
    lbl.className='build-section-label';
    lbl.textContent='Middle Section';
    addSec.appendChild(lbl);

    const inner=document.createElement('div');
    inner.className='build-section-inner';

    const sel=document.createElement('select');
    sel.className='bz-type-sel';
    ['Straight Cylinder','Cone','Tangent Ogive'].forEach(t=>{
      const o=document.createElement('option');o.value=t;o.textContent=t;sel.appendChild(o);
    });

    const btn=document.createElement('button');
    btn.className='btn btn-ghost btn-sm';btn.textContent='+ Add';
    btn.onclick=()=>{
      // Only add if there's budget
      const budget=remainingBudget(0);
      if(budget<1){
        // Flash the length bar red briefly to signal no room
        const valEl=document.getElementById('lengthVal');
        if(valEl){valEl.style.color='var(--red)';setTimeout(()=>updateLengthBar(),800);}
        return;
      }
      const defLen=Math.min(50,Math.floor(budget));
      buildSegs.middles.push({type:sel.value,len:defLen,d_end:50,flipped:false});
      renderBuildUI();buildProfile();
    };

    inner.appendChild(sel);
    inner.appendChild(btn);
    addSec.appendChild(inner);
    row.appendChild(addSec);
    row.appendChild(makeBuildSep());
  }

  row.appendChild(makeBuildSection('right', buildSegs.right));
  area.appendChild(row);
}

function makeBuildSep(){
  const d=document.createElement('div');d.className='build-sep';return d;
}

function makeBuildSection(side, seg){
  const wrap=document.createElement('div');
  wrap.className='build-section';

  const lbl=document.createElement('span');
  lbl.className='build-section-label';
  lbl.textContent=side==='left'?'Left End':'Right End';
  wrap.appendChild(lbl);

  const inner=document.createElement('div');
  inner.className='build-section-inner';

  const sel=document.createElement('select');
  sel.className='bz-type-sel';
  SEG_TYPES.forEach(t=>{
    const o=document.createElement('option');o.value=t;o.textContent=t;
    if(t===seg.type)o.selected=true;sel.appendChild(o);
  });
  sel.onchange=()=>{buildSegs[side].type=sel.value;renderBuildUI();buildProfile();};
  inner.appendChild(sel);

  const type=seg.type;

  if(side==='left'){
    if(['Hemisphere','Flat End Cap','Straight Cylinder','Cone','Tangent Ogive'].includes(type)){
      inner.appendChild(makeBuildLabel('Diameter'));
      // Diameter doesn't contribute to length directly (length comes from radius for Hemisphere)
      // so we validate normally for its own range
      inner.appendChild(makeBuildInput(seg.d||50, 20, 160, v=>{
        buildSegs[side].d=v;
        renderBuildUI();buildProfile();
      }, () => {
        // Compute max diameter: for Hemisphere the length contribution = d/2
        // Budget = remaining budget treating this segment as having its old length
        const oldLen = seg.type==='Hemisphere' ? (seg.d||50)/2 : (seg.len||30);
        return { min:20, max: seg.type==='Hemisphere' ? Math.min(160, remainingBudget(oldLen)*2) : 160 };
      }));
      inner.appendChild(makeBuildUnit('mm'));
    }
  } else {
    const joints=getJointDiameters();
    const inheritedD=joints[joints.length-1].startD;
    const info=document.createElement('span');
    info.style.cssText='font-family:var(--mono);font-size:9px;color:var(--muted);white-space:nowrap;';
    info.textContent='⌀'+inheritedD.toFixed(1)+'mm';
    inner.appendChild(info);
  }

  if(['Cone','Tangent Ogive','Straight Cylinder'].includes(type)){
    inner.appendChild(makeBuildLabel('Length'));
    const oldLen = seg.len||30;
    inner.appendChild(makeBuildInput(oldLen, 1, MAX_LEN, v=>{
      buildSegs[side].len=v;buildProfile();
    }, () => {
      return { min:1, max: Math.max(1, Math.floor(remainingBudget(buildSegs[side].len||30))) };
    }));
    inner.appendChild(makeBuildUnit('mm'));
  }

  wrap.appendChild(inner);
  return wrap;
}

function makeMidSeg(seg,i){
  const wrap=document.createElement('div');
  wrap.className='build-section';

  const joints=getJointDiameters();
  const startD=joints[i+1]?.startD??50;

  const lbl=document.createElement('span');
  lbl.className='build-section-label';
  lbl.textContent='Middle '+(i+1)+' (⌀'+startD.toFixed(0)+'mm)';
  wrap.appendChild(lbl);

  const inner=document.createElement('div');
  inner.className='build-section-inner';

  const sel=document.createElement('select');
  sel.className='bz-type-sel';
  ['Straight Cylinder','Cone','Tangent Ogive'].forEach(t=>{
    const o=document.createElement('option');o.value=t;o.textContent=t;
    if(t===seg.type)o.selected=true;sel.appendChild(o);
  });
  sel.onchange=()=>{buildSegs.middles[i].type=sel.value;renderBuildUI();buildProfile();};
  inner.appendChild(sel);

  // Length — constrained by total budget
  inner.appendChild(makeBuildLabel('Length'));
  inner.appendChild(makeBuildInput(seg.len||50, 1, MAX_LEN, v=>{
    buildSegs.middles[i].len=v;buildProfile();
  }, () => {
    return { min:1, max: Math.max(1, Math.floor(remainingBudget(buildSegs.middles[i].len||50))) };
  }));
  inner.appendChild(makeBuildUnit('mm'));

  if(seg.type!=='Straight Cylinder'){
    inner.appendChild(makeBuildLabel('End ⌀'));
    inner.appendChild(makeBuildInput(seg.d_end||50, 20, 160, v=>{buildSegs.middles[i].d_end=v;renderBuildUI();buildProfile();}));
    inner.appendChild(makeBuildUnit('mm'));

    const flip=document.createElement('button');
    flip.className='btn btn-ghost btn-sm';
    flip.style.cssText='padding:4px 7px;font-size:9px;'+(seg.flipped?'border-color:var(--accent);color:var(--accent);':'');
    flip.title='Flip direction';flip.textContent='⇄';
    flip.onclick=()=>{buildSegs.middles[i].flipped=!buildSegs.middles[i].flipped;renderBuildUI();buildProfile();};
    inner.appendChild(flip);
  }

  const rm=document.createElement('button');rm.className='rm';rm.textContent='×';
  rm.onclick=()=>{buildSegs.middles.splice(i,1);renderBuildUI();buildProfile();};
  inner.appendChild(rm);

  wrap.appendChild(inner);
  return wrap;
}

function makeBuildLabel(txt){
  const s=document.createElement('span');
  s.className='lir-label';s.textContent=txt;return s;
}
function makeBuildUnit(txt){
  const s=document.createElement('span');
  s.className='lir-unit';s.textContent=txt;return s;
}

// makeBuildInput — `getBounds` is called once at render time to snapshot the budget
// ceiling for this field (other segments' committed lengths are frozen at that moment).
// This avoids the drift problem where a partially-typed invalid value changes what
// remainingBudget() reports mid-edit.
function makeBuildInput(val, mn, mx, onChange, getBounds){
  const inp=document.createElement('input');
  inp.type='number';inp.value=val;inp.min=mn;inp.max=mx;inp.step='1';
  inp.style.cssText='width:60px;background:var(--s2);border:1px solid var(--border);color:var(--text);font-family:var(--mono);font-size:11px;padding:4px 6px;border-radius:4px;appearance:none;';
  // Snapshot bounds now (at render time) so the ceiling is stable while the user types.
  // We refresh the ceiling only after a valid commit, via renderBuildUI re-render.
  const bounds = getBounds ? getBounds() : {min:mn, max:mx};
  inp.oninput=()=>{
    const v = +inp.value;
    if(isNaN(v) || v < bounds.min || v > bounds.max){
      inp.classList.add('invalid');
      inp.title = 'Max allowed: ' + bounds.max + 'mm (total mandrel length cannot exceed 750mm)';
      // Still update the length bar so the user sees the overage in red
      updateLengthBar();
    } else {
      inp.classList.remove('invalid');
      inp.title = '';
      onChange(v);
    }
  };
  return inp;
}

function mkSP(lbl,val,onChange,mn=1,mx=5000){
  const wrap=document.createElement('div');wrap.className='sp';
  const l=document.createElement('label');l.textContent=lbl;
  const inp=document.createElement('input');
  inp.type='number';inp.value=val;inp.min=mn;inp.max=mx;inp.step='1';
  inp.oninput=()=>{
    validateInput(inp,mn,mx);
    if(!inp.classList.contains('invalid')){
      onChange(+inp.value);
    }
  };
  wrap.appendChild(l);wrap.appendChild(inp);return wrap;
}

function getJointDiameters(){
  const joints=[];
  let prevD=(buildSegs.left.d||50);
  joints.push({startD:0, endD:prevD});
  buildSegs.middles.forEach((seg,i)=>{
    const startD=prevD;
    let endD;
    if(seg.type==='Straight Cylinder'){
      endD=startD;
    } else {
      endD=seg.d_end||50;
      if(seg.flipped) endD=startD;
    }
    joints.push({startD, endD});
    prevD=endD;
  });
  joints.push({startD:prevD, endD:0});
  return joints;
}

// ══════════════════════════════════════════
// Build segment profile generator
// ══════════════════════════════════════════
function buildSegmentProfile(){
  const pts=[];
  let x=0, prevR=0;

  const ls=buildSegs.left, lt=ls.type, lr=(ls.d||50)/2;
  if(lt==='Hemisphere'){
    for(let i=0;i<=12;i++){const t=(i/12)*(Math.PI/2);pts.push({x:lr*(1-Math.cos(t)),r:lr*Math.sin(t)});}
    x=lr;prevR=lr;
  } else if(lt==='Flat End Cap'){
    pts.push({x:0,r:0},{x:0.5,r:lr});x=0.5;prevR=lr;
  } else if(lt==='Cone'){
    const L=ls.len||30;pts.push({x:0,r:0},{x:L,r:lr});x=L;prevR=lr;
  } else if(lt==='Tangent Ogive'){
    const L=ls.len||30;
    const fwd=sampleOgive(0,lr,L);
    const flipped=fwd.map(p=>({x:L-p.x,r:p.r})).reverse();
    flipped.forEach(p=>pts.push({x:p.x,r:p.r}));
    x=L;prevR=lr;
  } else {
    const L=ls.len||30;pts.push({x:0,r:lr},{x:L,r:lr});x=L;prevR=lr;
  }

  buildSegs.middles.forEach(seg=>{
    const L=seg.len||50, rEnd=(seg.d_end||50)/2;
    if(seg.type==='Straight Cylinder'){
      if(!(pts.length&&pts[pts.length-1].x===x&&pts[pts.length-1].r===prevR))
        pts.push({x,r:prevR});
      pts.push({x:x+L,r:prevR});x+=L;
    } else if(seg.type==='Cone'){
      if(seg.flipped){
        pts.push({x,r:rEnd},{x:x+L,r:prevR});x+=L;
      } else {
        pts.push({x,r:prevR},{x:x+L,r:rEnd});x+=L;prevR=rEnd;
      }
    } else if(seg.type==='Tangent Ogive'){
      if(seg.flipped){
        const ogPts=sampleOgive(0,rEnd,L);
        const flippedPts=ogPts.map(p=>({x:x+(L-p.x),r:p.r})).reverse();
        flippedPts.forEach((p,fi)=>{if(fi>0)pts.push(p);});
        x+=L;prevR=flippedPts[flippedPts.length-1].r;
      } else {
        const ogPts=sampleOgive(x,prevR,L);
        ogPts.forEach((p,oi)=>{if(oi>0)pts.push(p);});
        x+=L;prevR=ogPts[ogPts.length-1].r;
      }
    }
  });

  const rs=buildSegs.right, rt=rs.type;
  if(rt==='Hemisphere'){
    for(let i=1;i<=12;i++){const t=(i/12)*(Math.PI/2);pts.push({x:x+prevR*Math.sin(t),r:prevR*Math.cos(t)});}
  } else if(rt==='Flat End Cap'){
    pts.push({x:x,r:prevR},{x:x+0.5,r:0});
  } else if(rt==='Cone'){
    const L=rs.len||30;pts.push({x:x,r:prevR},{x:x+L,r:0});
  } else if(rt==='Tangent Ogive'){
    const L=rs.len||30;
    const ogPts=sampleOgive(x,prevR,L);
    ogPts.forEach((p,i)=>{if(i>0)pts.push(p);});
  } else {
    const L=rs.len||30;pts.push({x:x,r:prevR},{x:x+L,r:prevR});
  }
  return pts;
}

