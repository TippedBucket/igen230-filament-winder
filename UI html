<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Winder Controller</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg:      #07090d;
  --s1:      #0c111a;
  --s2:      #111720;
  --s3:      #161e2a;
  --border:  #1e2a38;
  --border2: #2a3c52;
  --accent:  #3ecfff;
  --green:   #2ed891;
  --orange:  #ff7a45;
  --yellow:  #ffd045;
  --red:     #ff4a5e;
  --text:    #eef4ff;
  --text2:   #d0dfdf;
  --muted:   #9ec1e6;
  --mono:    'DM Mono', monospace;
  --sans:    'DM Sans', sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:15px;display:flex;flex-direction:column;}

/* ── App bar ── */
.appbar{
  height:48px;background:var(--s1);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 20px;flex-shrink:0;z-index:60;
}
.brand{display:flex;align-items:center;gap:9px;margin-right:32px;}
.brand-ring{
  width:26px;height:26px;border:1.5px solid var(--accent);border-radius:50%;
  display:grid;place-items:center;animation:spin 9s linear infinite;
}
.brand-ring::after{content:'';width:7px;height:7px;background:var(--accent);border-radius:50%;}
@keyframes spin{to{transform:rotate(360deg);}}
.brand-name{font-family:var(--mono);font-size:12px;letter-spacing:3px;color:var(--accent);text-transform:uppercase;}

.page-tabs{display:flex;height:100%;}
.page-tab{
  height:100%;padding:0 20px;display:flex;align-items:center;gap:7px;
  font-family:var(--mono);font-size:10px;letter-spacing:2px;text-transform:uppercase;
  color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;user-select:none;
}
.page-tab:hover{color:var(--text2);}
.page-tab.active{color:var(--accent);border-bottom-color:var(--accent);}

.status-pill{
  margin-left:auto;display:flex;align-items:center;gap:7px;padding:4px 13px;
  border:1px solid var(--border2);border-radius:20px;
  font-family:var(--mono);font-size:9px;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;transition:all .3s;
}
.status-pill.ok  {border-color:var(--green);color:var(--green);}
.status-pill.live{border-color:var(--accent);color:var(--accent);}
.status-pill.err {border-color:var(--red);color:var(--red);}
.sdot{width:6px;height:6px;border-radius:50%;background:currentColor;}
.status-pill.live .sdot{animation:blink 1s ease-in-out infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

/* ── Pages ── */
.page{display:none;flex:1;flex-direction:column;overflow:hidden;min-height:0;}
.page.active{display:flex;}

/* ═══════════════════════════
   DESIGN PAGE
═══════════════════════════ */
.config-bar{
  background:var(--s1);border-bottom:1px solid var(--border);
  flex-shrink:0;display:flex;flex-direction:column;
}
.config-tabs{display:flex;border-bottom:1px solid var(--border);}
.cfg-tab{
  padding:0 22px;height:36px;display:flex;align-items:center;gap:6px;
  font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;
  color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .12s;
}
.cfg-tab:hover{color:var(--text2);}
.cfg-tab.active{color:var(--accent);border-bottom-color:var(--accent);}

.cfg-panel{display:none;padding:12px 18px;}
.cfg-panel.active{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;}

/* Axis selector */
.axis-chips{display:flex;gap:7px;}
.ax-chip{
  background:var(--s2);border:1px solid var(--border);border-radius:5px;
  padding:7px 13px;cursor:pointer;text-align:center;transition:all .12s;min-width:60px;
}
.ax-chip:hover{border-color:var(--border2);}
.ax-chip.active{border-color:var(--accent);background:rgba(62,207,255,.07);}
.ax-chip .an{font-family:var(--mono);font-size:20px;color:var(--muted);line-height:1;margin-bottom:2px;transition:color .12s;}
.ax-chip.active .an{color:var(--accent);}
.ax-chip .al{font-family:var(--mono);font-size:8px;letter-spacing:1px;color:var(--muted);text-transform:uppercase;}
.ax-desc{font-family:var(--mono);font-size:10px;color:var(--text2);line-height:1.55;max-width:340px;align-self:center;}

/* Fields */
.fg{display:grid;gap:9px;}
.fg2{grid-template-columns:1fr 1fr;}
.fg3{grid-template-columns:1fr 1fr 1fr;}
.fg4{grid-template-columns:repeat(4,1fr);}
.fld{display:flex;flex-direction:column;gap:4px;}
.fld label{
  font-family:var(--mono);font-size:8px;letter-spacing:1.5px;
  color:var(--text2);text-transform:uppercase;
}
.fld input,.fld select{
  background:var(--s2);border:1px solid var(--border);color:var(--text);
  font-family:var(--mono);font-size:12px;padding:6px 9px;border-radius:4px;width:100%;
  transition:border-color .12s,box-shadow .12s;appearance:none;
}
.fld input:focus,.fld select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px rgba(62,207,255,.1);}
.fld input::placeholder{color:var(--muted);}
.fld input.invalid,.sp input.invalid{border-color:var(--red)!important;box-shadow:0 0 0 2px rgba(255,74,94,.15)!important;}

/* Profile modes */
.profile-modes{display:flex;gap:7px;flex-wrap:wrap;}
.pmode{
  background:var(--s2);border:1px solid var(--border);border-radius:5px;
  padding:6px 13px;cursor:pointer;font-family:var(--mono);font-size:9px;
  letter-spacing:1.5px;text-transform:uppercase;color:var(--text2);transition:all .12s;
}
.pmode:hover{border-color:var(--border2);}
.pmode.active{border-color:var(--accent);color:var(--accent);background:rgba(62,207,255,.06);}

.profile-sub{display:none;width:100%;}
.profile-sub.active{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start;}

/* ── Build mode — single inline row ── */
.build-row{
  display:flex;align-items:flex-end;flex-wrap:wrap;gap:6px;width:100%;
}
.build-section{
  display:flex;flex-direction:column;gap:3px;
}
.build-section-label{
  font-family:var(--mono);font-size:7px;letter-spacing:2px;color:var(--accent);
  text-transform:uppercase;white-space:nowrap;
}
.build-section-inner{
  display:flex;align-items:center;gap:6px;
}
.bz-type-sel{
  background:var(--s2);border:1px solid var(--border);color:var(--text);
  font-family:var(--mono);font-size:10px;padding:5px 7px;border-radius:4px;
  appearance:none;cursor:pointer;
}
.bz-type-sel:focus{outline:none;border-color:var(--accent);}
.build-sep{
  width:1px;height:28px;background:var(--border2);flex-shrink:0;align-self:flex-end;margin-bottom:2px;
}

/* Custom table */
.cust-table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px;margin-bottom:8px;}
.cust-table th{
  text-align:left;padding:4px 8px;font-size:8px;letter-spacing:1.5px;
  color:var(--text2);text-transform:uppercase;border-bottom:1px solid var(--border);
}
.cust-table td{padding:3px 8px;border-bottom:1px solid rgba(30,42,56,.7);}
.cust-table td input{
  background:transparent;border:none;border-bottom:1px solid transparent;
  color:var(--text);font-family:var(--mono);font-size:11px;width:80px;
  transition:border-color .12s;
}
.cust-table td input:focus{outline:none;border-bottom-color:var(--accent);color:var(--accent);}
.cust-table tr:hover td{background:rgba(62,207,255,.02);}

/* Layer cards */
.layer-list{display:flex;flex-direction:row;flex-wrap:wrap;gap:5px;}
.layer-card{
  background:var(--s2);border:1px solid var(--border);border-radius:4px;
  padding:8px 12px;display:inline-flex;align-items:center;gap:10px;
  width:auto;flex-shrink:0;
}
.layer-card:hover{border-color:var(--border2);}
.lnum{font-family:var(--mono);font-size:10px;color:var(--accent);min-width:20px;}
.lstats{flex:1;display:flex;gap:14px;}
.lstat{display:flex;flex-direction:column;gap:1px;}
.lsl{font-family:var(--mono);font-size:7px;color:var(--text2);letter-spacing:1px;text-transform:uppercase;}
.lsv{font-family:var(--mono);font-size:12px;color:var(--text);}

/* ── Layer inline input row ── */
.layer-input-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.lir-group {
  display: flex;
  align-items: center;
  gap: 5px;
}
.lir-label {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text2);
  white-space: nowrap;
  letter-spacing: 0.5px;
}
.lir-unit {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--muted);
  white-space: nowrap;
}
.lir-group input {
  background: var(--s2);
  border: 1px solid var(--border);
  color: var(--text);
  font-family: var(--mono);
  font-size: 12px;
  padding: 5px 7px;
  border-radius: 4px;
  width: 70px;
  transition: border-color .12s, box-shadow .12s;
  appearance: none;
}
.lir-group input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(62,207,255,.1);
}
.lir-group input.invalid {
  border-color: var(--red) !important;
  box-shadow: 0 0 0 2px rgba(255,74,94,.15) !important;
}
.lir-sep {
  width: 1px;
  height: 20px;
  background: var(--border);
  flex-shrink: 0;
}

/* Buttons */
.btn{
  font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;
  padding:7px 14px;border-radius:4px;border:1px solid;cursor:pointer;
  transition:all .12s;display:inline-flex;align-items:center;justify-content:center;gap:5px;white-space:nowrap;
}
.btn-ghost{background:transparent;border-color:var(--border2);color:var(--text2);}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);}
.btn-solid{background:var(--accent);border-color:var(--accent);color:var(--bg);font-weight:500;}
.btn-solid:hover{background:#70dcff;}
.btn-green{background:var(--green);border-color:var(--green);color:var(--bg);font-weight:500;}
.btn-green:hover{background:#55eaaa;}
.btn-green:disabled{opacity:.35;cursor:not-allowed;}
.btn-sm{padding:5px 10px;font-size:8px;}
.btn-full{width:100%;}
.rm{background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;padding:2px 4px;border-radius:2px;transition:color .12s;flex-shrink:0;}
.rm:hover{color:var(--red);}

.empty-note{font-family:var(--mono);font-size:9px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;padding:6px 0;}

/* ── Canvas ── */
.canvas-area{flex:1;min-height:0;background:var(--bg);position:relative;overflow:hidden;}
canvas#mainCanvas{display:block;position:absolute;top:0;left:0;width:100%;height:100%;}

/* ═══════════════════════════
   TRANSMIT PAGE
═══════════════════════════ */
.tx-page{flex:1;display:grid;grid-template-columns:440px 1fr;overflow:hidden;}
.tx-left{background:var(--s1);border-right:1px solid var(--border);padding:22px;overflow-y:auto;display:flex;flex-direction:column;gap:16px;}
.tx-left::-webkit-scrollbar{width:3px;}
.tx-left::-webkit-scrollbar-thumb{background:var(--border2);}
.tx-right{display:flex;flex-direction:column;overflow:hidden;}

.card{background:var(--s2);border:1px solid var(--border);border-radius:7px;overflow:hidden;}
.card-head{padding:10px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.card-title{font-family:var(--mono);font-size:8px;letter-spacing:2px;color:var(--accent);text-transform:uppercase;}
.card-body{padding:15px;}

.port-row{display:flex;gap:7px;align-items:flex-end;margin-bottom:10px;}
.port-row .fld{flex:1;margin:0;}
.hint{font-size:11px;color:var(--text2);line-height:1.5;font-family:var(--mono);}

.sum-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px;}
.sum-item{background:var(--bg);border:1px solid var(--border);border-radius:4px;padding:10px;}
.sum-item .sl{font-family:var(--mono);font-size:7px;letter-spacing:1.5px;color:var(--text2);text-transform:uppercase;margin-bottom:3px;}
.sum-item .sv{font-family:var(--mono);font-size:15px;color:var(--text);}
.sum-item .su{font-size:9px;color:var(--muted);margin-left:2px;}

.ax-badge{
  display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:3px;
  font-family:var(--mono);font-size:8px;letter-spacing:1px;text-transform:uppercase;
  margin-right:5px;margin-bottom:5px;
}
.ax-badge.on {background:rgba(62,207,255,.1);color:var(--accent);border:1px solid rgba(62,207,255,.2);}
.ax-badge.off{background:rgba(72,88,110,.1);color:var(--muted);border:1px solid var(--border);}

.json-box{
  background:var(--bg);border:1px solid var(--border);border-radius:4px;
  padding:12px;font-family:var(--mono);font-size:10px;color:#7fd8f0;
  max-height:160px;overflow-y:auto;white-space:pre;line-height:1.6;
}
.json-box::-webkit-scrollbar{width:3px;}
.json-box::-webkit-scrollbar-thumb{background:var(--border2);}

.log-head{
  padding:9px 16px;border-bottom:1px solid var(--border);background:var(--s1);flex-shrink:0;
  display:flex;align-items:center;justify-content:space-between;
}
.log-title{font-family:var(--mono);font-size:8px;letter-spacing:2px;color:var(--text2);text-transform:uppercase;}
.serial-log{
  flex:1;background:var(--bg);overflow-y:auto;padding:14px;
  font-family:var(--mono);font-size:11px;display:flex;flex-direction:column;gap:3px;min-height:0;
}
.serial-log::-webkit-scrollbar{width:3px;}
.serial-log::-webkit-scrollbar-thumb{background:var(--border2);}
.lr{display:flex;gap:10px;align-items:baseline;}
.lt{color:var(--muted);min-width:54px;font-size:9px;}
.lm{color:var(--text2);}
.lm.rx{color:var(--green);}
.lm.tx{color:var(--accent);}
.lm.err{color:var(--red);}
.lm.sys{color:var(--yellow);}
.send-foot{padding:16px;border-top:1px solid var(--border);background:var(--s1);flex-shrink:0;}
</style>
</head>
<body>

<div class="appbar">
  <div class="brand">
    <div class="brand-ring"></div>
    <span class="brand-name">Winder Controller</span>
  </div>
  <div class="page-tabs">
    <div class="page-tab active" id="pt-design"   onclick="showPage('design')">◈ Design</div>
    <div class="page-tab"        id="pt-transmit" onclick="showPage('transmit')">⇆ Transmit</div>
  </div>
  <div class="status-pill" id="statusPill">
    <div class="sdot"></div>
    <span id="statusTxt">NOT CONNECTED</span>
  </div>
</div>

<div class="page active" id="page-design">
  <div class="config-bar">
    <div class="config-tabs">
      <div class="cfg-tab active" id="ct-axes"    onclick="cfgTab('axes')">① Axes</div>
      <div class="cfg-tab"        id="ct-profile" onclick="cfgTab('profile')">② Profile</div>
      <div class="cfg-tab"        id="ct-layers"  onclick="cfgTab('layers')">③ Layers</div>
    </div>

    <div class="cfg-panel active" id="cp-axes" style="flex-direction:column; gap:12px;">
      <div style="display:flex; gap:14px; align-items:flex-start; flex-wrap:wrap; width:100%;">
        <div class="axis-chips">
          <div class="ax-chip"        id="ax2" onclick="setAxes(2)"><div class="an">2</div><div class="al">Axes</div></div>
          <div class="ax-chip"        id="ax3" onclick="setAxes(3)"><div class="an">3</div><div class="al">Axes</div></div>
          <div class="ax-chip active" id="ax4" onclick="setAxes(4)"><div class="an">4</div><div class="al">Axes</div></div>
        </div>
        <div class="ax-desc" id="axDesc"></div>
      </div>
      <div id="simpleParams" style="display:none; gap:12px; flex-wrap:wrap; align-items:flex-end; width:100%;">
        <div class="fld"><label>Mandrel Length (mm)</label><input type="number" id="manLen" value="400" min="1" max="750" step="1" oninput="validateInput(this,1,750);redraw()"></div>
        <div class="fld"><label>Mandrel Diameter (mm)</label><input type="number" id="manDiam" value="50" min="20" max="160" step="1" oninput="validateInput(this,20,160);redraw()"></div>
      </div>
    </div>

    <div class="cfg-panel" id="cp-profile">
      <div style="display:flex;flex-direction:column;gap:10px;width:100%">

        <!-- Single inline control row: Standoff + mode buttons -->
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <div class="lir-group" id="soFld">
            <span class="lir-label">Standoff</span>
            <input type="number" id="standoff" value="100" min="50" max="250" step="1"
              oninput="validateInput(this,50,250);redraw()"
              style="width:65px;">
            <span class="lir-unit">mm</span>
          </div>
          <div class="lir-sep"></div>
          <div class="profile-modes" id="profileModes" style="display:flex;align-items:center;gap:7px;margin:0;">
            <div class="pmode active" id="pm-cylhemi" onclick="setProfileMode('cylhemi')">Cylinder + Hemi Ends</div>
            <div class="pmode"        id="pm-build"   onclick="setProfileMode('build')">Build</div>
            <div class="pmode"        id="pm-custom"  onclick="setProfileMode('custom')">Custom</div>
          </div>
        </div>

        <!-- Total length indicator -->
        <div id="lengthBar" style="display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:10px;">
          <span style="color:var(--text2);letter-spacing:1px;">TOTAL LENGTH:</span>
          <span id="lengthVal" style="color:var(--accent);">—</span>
          <span style="color:var(--muted);">/ 750mm</span>
          <span id="lengthWarn" style="color:var(--red);letter-spacing:1px;display:none;"></span>
        </div>

        <div class="profile-sub active" id="ps-cylhemi">
          <div class="fg fg2" style="min-width:200px">
            <div class="fld"><label>Cylinder Length (mm)</label><input type="number" id="ch-len" value="400" min="1" max="749" step="1" oninput="onCylHemiChange()"></div>
            <div class="fld"><label>Diameter (mm)</label><input type="number" id="ch-diam" value="50" min="20" max="160" step="1" oninput="onCylHemiChange()"></div>
          </div>
        </div>

        <div class="profile-sub" id="ps-build">
          <div style="width:100%" id="buildArea"></div>
        </div>

        <div class="profile-sub" id="ps-custom">
          <div style="display:flex;flex-direction:column;gap:8px;width:100%;max-width:340px">
            <table class="cust-table">
              <thead><tr>
                <th>#</th><th>X (mm)</th><th>Diameter (mm)</th><th></th>
              </tr></thead>
              <tbody id="custBody"></tbody>
            </table>
            <button class="btn btn-ghost btn-sm" onclick="addCustPt()" style="align-self:flex-start">+ Add Point</button>
          </div>
        </div>
      </div>
    </div>

    <div class="cfg-panel" id="cp-layers">
      <div style="display:flex;flex-direction:column;gap:10px;width:100%">

        <!-- Inline layer input row -->
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <div class="layer-input-row">
            <div class="lir-group">
              <span class="lir-label">Length</span>
              <input type="number" id="ll" value="400" min="1" max="750" step="1" oninput="validateInput(this,1,750)">
              <span class="lir-unit">mm</span>
            </div>
            <div class="lir-sep"></div>
            <div class="lir-group">
              <span class="lir-label">Angle</span>
              <input type="number" id="la" value="45" min="0" max="90" step="1" oninput="validateInput(this,0,90)">
              <span class="lir-unit">deg</span>
            </div>
            <div class="lir-sep"></div>
            <div class="lir-group">
              <span class="lir-label">Stepover</span>
              <input type="number" id="ls" value="2" min="0" max="25" step="0.1" oninput="validateInput(this,0,25)">
              <span class="lir-unit">mm</span>
            </div>
            <div class="lir-sep"></div>
            <div class="lir-group">
              <span class="lir-label">Dwell</span>
              <input type="number" id="ld" value="180" min="0" max="360" step="5" oninput="validateInput(this,0,360)">
              <span class="lir-unit">deg</span>
            </div>
            <div class="lir-sep"></div>
            <div class="lir-group">
              <span class="lir-label">Offset</span>
              <input type="number" id="lo" value="0" min="0" max="740" step="1" oninput="validateInput(this,0,740)">
              <span class="lir-unit">mm</span>
            </div>
          </div>
          <button class="btn btn-ghost" onclick="addLayer()">+ Add</button>
        </div>

        <div class="layer-list" id="layerList">
          <div class="empty-note">No layers yet — fill fields above and click Add</div>
        </div>
      </div>
    </div>
  </div>

